# ─── Frontend ──────────────────────────────────────────────────────────────────
# The URL of the API server. Must match the API port and prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# The Stellar network to use in the frontend (testnet or public)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ─── API Playground ───────────────────────────────────────────────────────────
# Public API bases the Playground prints in its provider labels and in the
# "Copy as cURL" sample. Both are optional: uncomment a line to point the
# Playground at your own deployment, otherwise the hosted defaults below apply.
# Whatever is set here is also added to the Content-Security-Policy connect-src
# allow-list, so a custom origin is actually reachable from the browser.
# NEXT_PUBLIC_FLUXA_API_URL=https://api.fluxa.io
# NEXT_PUBLIC_CROWDPAY_API_URL=https://crowdpay.up.railway.app
