# ══════════════════════════════════════════════════════════════════════════
# ROOT ENVIRONMENT TEMPLATE (Savitura/Savitools#197)
# ══════════════════════════════════════════════════════════════════════════
# This file covers ROOT INFRASTRUCTURE ONLY: the shared services
# (Postgres/Redis) started by docker-compose and the container-level
# variables they need. Application variables read by the API or web app
# belong in the per-app templates:
#
#   - apps/api/.env.example  → full list of every runtime-read API variable
#   - apps/web/.env.example  → frontend build-time variables
# ══════════════════════════════════════════════════════════════════════════

# ─── Database (shared Postgres service) ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=savitools
DATABASE_URL=postgresql://postgres:password@localhost:5432/savitools

# ─── Redis (shared Redis service) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS / origins ──────────────────────────────────────────────────────────
# Allowed origin for API and WebSocket CORS (read by the API and gateway).
WEB_ORIGIN=http://localhost:3000

# ─── Rate Limiting (global @nestjs/throttler) ────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Frontend API URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Compose ports (docker-compose.dev.yml / docker-compose.yml) ─────────────
# Every published port is parameterised: change it here instead of editing the
# compose files. Keep NEXT_PUBLIC_API_URL in step with API_PORT.
API_PORT=3001
API_PREFIX=api
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── Contracts deployer key (REQUIRED to boot the API) ───────────────────────
# ContractsService calls getOrThrow + Keypair.fromSecret while it is being
# constructed, so the API cannot start without a syntactically valid Stellar
# secret key (56 chars, starting with S). Generate a throwaway TESTNET keypair:
#
#   npm install
#   node -p "require('@stellar/stellar-sdk').Keypair.random().secret()"
#
# Funding it is only necessary to actually deploy a contract.
DEPLOYER_SECRET_KEY=
